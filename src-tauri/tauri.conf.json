{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlowGuard",
  "version": "0.1.1",
  "identifier": "com.flowguard.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FlowGuard",
        "width": 1440,
        "height": 960,
        "minWidth": 800,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": [
      "app"
    ],
    "category": "Utility",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "infoPlist": "Info.plist",
      "bundleVersion": "2"
    },
    "shortDescription": "Understand your Mac’s network connections"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZDNzgzNzc4M0EwMTc1RTkKUldUcGRRRTZlRGQ0L0FQdktTZEY4RCtyeXZJc24xdUNoVjMrZDVacmNzSDRqQStOTEZBQ1Fjd2QK",
      "endpoints": [
        "https://github.com/matsushibadenki/FlowGuard/releases/latest/download/latest.json"
      ]
    }
  }
}
