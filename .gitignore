# Frontend dependencies and build output
node_modules/
/dist/
/.vite/
*.tsbuildinfo

# Rust / Tauri build output and generated schemas
/src-tauri/target/
/src-tauri/gen/

# Swift Package Manager / Xcode local build state
native/**/.build/
native/**/.swiftpm/
DerivedData/
xcuserdata/
*.xcuserstate

# Test and coverage output
/coverage/
/playwright-report/
/test-results/

# Local environment and secrets
.env
.env.*
!.env.example
!.env.*.example
*.local

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# macOS metadata and editor temporary files
.DS_Store
._*
*.swp
*.swo
*~

# Keep dependency lockfiles, source assets, and signing templates tracked.

# Unsigned native extension staging bundles and Swift build caches
/native/build/

# Python packaging-tool caches
__pycache__/
*.pyc
